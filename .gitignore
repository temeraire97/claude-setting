# --- Claude Code dotfiles — ignore list ---

# Runtime logs (written by sync.sh / launchd; not configuration)
*.log

# macOS noise
.DS_Store

# Secret-prone files — must never reach this public repo
*.local.json
.env
.env.*
*credentials*
*.secret
/mcp.json

# never back up per-project memory (may contain client-confidential data) — repo is PUBLIC
projects/
*/memory/

# local-only skill values — never back up
*.local.md

# plugin install caches — machine state (paths/SHAs). Restore is declarative via
# enabledPlugins + extraKnownMarketplaces in settings.json, so these are not backed up.
plugins/installed_plugins.json
plugins/known_marketplaces.json
